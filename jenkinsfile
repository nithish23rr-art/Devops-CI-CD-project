pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install & Test') {
            steps {
                sh '''
                    pip install -r requirements.txt
                    python -m pytest test_app.py
                '''
            }
        }

        stage('Build Image') {
            steps {
                sh 'docker build -t flask-web-app .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker stop flask-app || true
                    docker rm flask-app || true
                    docker run -d --name flask-app -p 5000:5000 flask-web-app
                '''
            }
        }
    }
}
