pipeline {
    agent any

    stages {
        stage('Build image') {
            steps {
                echo 'docker build -t my-python-app .'
                sh 'docker build -t my-python-app .'
            }
        }
        stage('Test image') {
            steps {
                echo 'Testing image...'
                sh 'docker run --rm my-python-app python -m unittest discover tests'
            

            }
        }
        stage('Deploy image') {
            steps {
                echo 'Deploying image...'
                sh 'docker run -d -p 5000:5000 my-python-app'
            }
        }
    }

    post {
        success {
            echo 'pipeline completed successfully! App is running on port 5000.'
        }
        failure {
            echo 'pipeline failed. please check the logs.'
        }
    }
}
//
