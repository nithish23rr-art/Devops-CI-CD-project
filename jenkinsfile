 pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/nithish23rr-art/Devops-CI-CD-project.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the Python project...'
            sh 'python3 -m venv venv'
            sh './venv/bin/pip install -r requirements.txt
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            sh './venv/bin/pip install pytest'
            sh './venv/bin/pytest'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying the application...'        
                sh './deploy.sh'
            }
        }
    }
}
